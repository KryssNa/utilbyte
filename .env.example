# UtilByte Environment Variables
# Copy this file to .env.local and fill in the values you need.
# Most tools work without any environment variables.

# ──────────────────────────────────────────────
# Base URL (used for sitemap, canonical URLs, OG tags)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_BASE_URL=https://utilbyte.app

# ──────────────────────────────────────────────
# Supabase (only needed for: Request Catcher, API Client, Local Proxy)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────────────────────────
# Analytics & Advertising (optional)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Enable only after site approval, published CMP and manual ad units are configured.
# Disable Auto ads / optimization of existing units in AdSense; Focus Mode unmounts manual units.
# NEXT_PUBLIC_ADSENSE_ENABLED=true
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4931770581801597
# NEXT_PUBLIC_ADSENSE_IN_ARTICLE_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=0987654321

# ──────────────────────────────────────────────
# Sentry (optional — build tooling; runtime payload capture is disabled)
# ──────────────────────────────────────────────
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ──────────────────────────────────────────────
# Contact & Tool Feedback (optional — reuse one Slack webhook for both)
# ──────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Optional aggregate tool events. Disabled by default; never includes tool input.
# NEXT_PUBLIC_TOOL_METRICS=true

# Server relay: disabled unless BOTH settings are present. Never use NEXT_PUBLIC_ for the token.
# Use a random token of at least 32 characters, entered manually by authorized operators.
# PROXY_ACCESS_TOKEN=
# Exact HTTPS origins, comma-separated; no wildcards, ports other than 443 or arbitrary user destinations.
# PROXY_ALLOWED_ORIGINS=https://api.example.com
# Set these same two secrets in Supabase for Local Proxy configuration/forwarding.
# Supabase only: all forwarding uses the authenticated Next.js relay.
# UTILBYTE_PROXY_URL=https://utilbyte.app/api/proxy
# Google CMP must enable consent mode for advertising AND analytics before Google tags can use consent.
